# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
# `.env` sudah masuk .gitignore sehingga tidak akan ikut ter-commit.

# --- Server ---
PORT=5000

# --- Database (SQLite) ---
# Path relatif akan.resolve dari folder config/
DB_STORAGE=database/database.sqlite

# Set true untuk menjalankan db.sync({ alter: true }).
# Di SQLite ini ME-RECREATE tabel, jadi data lama pada tabel yang berubah HILANG.
# Gunakan hanya saat ada perubahan kolom pada model.
DB_SYNC_ALTER=false

# --- Auth ---
# WAJIB diganti di produksi. fallback: kelompok1_secret_key
JWT_SECRET=kelompok1_secret_key
JWT_EXPIRES_IN=1d

# --- Seeder ---
# Password default untuk seluruh user yang dibuat seeder
SEED_PASSWORD=admin123
