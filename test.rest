@baseUrl = http://localhost:5000/api

### ========================================
### 1. AUTH - LOGIN (Admin/Owner)
### ========================================
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "admin123"
}

### ========================================
### 2. CRUD TEKNISI (Admin/Owner)
### ========================================
### GET Semua Teknisi
GET {{baseUrl}}/technicians
Authorization: Bearer {{login.response.body.data.token}}

### POST Tambah Teknisi
POST {{baseUrl}}/technicians
Authorization: Bearer {{login.response.body.data.token}}
Content-Type: application/json

{
    "name": "AAAA Teknisi",
    "phone": "081212121212",
    "status": "active"
}

### PUT Update Teknisi
PUT {{baseUrl}}/technicians/2
Authorization: Bearer {{login.response.body.data.token}}
Content-Type: application/json

{
    "name": "Budi Teknisi (Update)",
    "status": "active"
}

### ========================================
### 3. KATEGORI (Flat)
### ========================================
### GET Semua Kategori
GET {{baseUrl}}/categories
Authorization: Bearer {{login.response.body.data.token}}

### POST Tambah Kategori
POST {{baseUrl}}/categories
Authorization: Bearer {{login.response.body.data.token}}
Content-Type: application/json

{
    "name": "Cuci AC"
}

